{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaStrip Video",
  "version": "0.3.1",
  "identifier": "com.metastrip.video",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MetaStrip Video — Video Metadata Remover",
        "width": 900,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": [
      "FFMPEG-LICENSE.txt"
    ],
    "publisher": "MetaStrip",
    "shortDescription": "Fast, offline batch video metadata remover without re-encoding.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMzBBM0QwNTAyMjNDODUKUldTRlBDSlEwS013cjdKTUhhSlFvbDR5b1M3NmRXV2ZTSEZ6S2JGR01ySS91OFJoc0NMMXhDVE8K",
      "endpoints": [
        "https://github.com/emilioperna/metastrip-video/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
